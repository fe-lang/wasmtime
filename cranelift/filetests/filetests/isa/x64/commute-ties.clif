;; A constant stays the immediate operand.
function %xor_with_constant(i64, i64) {
block0(v0: i64, v1: i64):
  v2 = iconst.i64 0x1234
  v3 = bxor v0, v2
  store v3, v1
  v4 = bor v0, v1
  store v4, v1+8
  return
}

