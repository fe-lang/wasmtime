test compile precise-output
target x86_64 has_movbe

;; A load whose bytes are swapped, and a store of a value whose bytes are
;; swapped, move them with MOVBE.

function %load_swapped_i64(i64) -> i64 {
block0(v0: i64):
    v1 = load.i64 v0+8
    v2 = bswap v1
    return v2
}

; VCode:
;   pushq %rbp
;   movq %rsp, %rbp
; block0:
;   movbeq 8(%rdi), %rax
;   popq %rbp
;   retq
;
; Disassembled:
; block0: ; offset 0x0
;   pushq %rbp
;   movq %rsp, %rbp
; block1: ; offset 0x4
;   movbeq 8(%rdi), %rax ; trap: heap_oob
;   popq %rbp
;   retq

function %load_swapped_i32(i64) -> i32 {
block0(v0: i64):
    v1 = load.i32 v0
    v2 = bswap v1
    return v2
}

; VCode:
;   pushq %rbp
;   movq %rsp, %rbp
; block0:
;   movbel (%rdi), %eax
;   popq %rbp
;   retq
;
; Disassembled:
; block0: ; offset 0x0
;   pushq %rbp
;   movq %rsp, %rbp
; block1: ; offset 0x4
;   movbel (%rdi), %eax ; trap: heap_oob
;   popq %rbp
;   retq

function %store_swapped_i64(i64, i64) {
block0(v0: i64, v1: i64):
    v2 = bswap v1
    store v2, v0+16
    return
}

; VCode:
;   pushq %rbp
;   movq %rsp, %rbp
; block0:
;   movbeq %rsi, 0x10(%rdi)
;   popq %rbp
;   retq
;
; Disassembled:
; block0: ; offset 0x0
;   pushq %rbp
;   movq %rsp, %rbp
; block1: ; offset 0x4
;   movbeq %rsi, 0x10(%rdi) ; trap: heap_oob
;   popq %rbp
;   retq

function %store_swapped_i32(i32, i64) {
block0(v0: i32, v1: i64):
    v2 = bswap v0
    store v2, v1
    return
}

; VCode:
;   pushq %rbp
;   movq %rsp, %rbp
; block0:
;   movbel %edi, (%rsi)
;   popq %rbp
;   retq
;
; Disassembled:
; block0: ; offset 0x0
;   pushq %rbp
;   movq %rsp, %rbp
; block1: ; offset 0x4
;   movbel %edi, (%rsi) ; trap: heap_oob
;   popq %rbp
;   retq

