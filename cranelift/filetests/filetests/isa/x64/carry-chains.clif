function %carry_chain_through_memory(i64, i64, i64) {
block0(v0: i64, v1: i64, v2: i64):
    v3 = load.i64 v0
    v4 = load.i64 v1
    v5, v6 = uadd_overflow v3, v4
    store v5, v2
    v7 = load.i64 v0+8
    v8 = load.i64 v1+8
    v9, v10 = uadd_overflow_cin v7, v8, v6
    store v9, v2+8
    v11 = load.i64 v0+16
    v12 = load.i64 v1+16
    v13, v14 = uadd_overflow_cin v11, v12, v10
    store v13, v2+16
    return
}

