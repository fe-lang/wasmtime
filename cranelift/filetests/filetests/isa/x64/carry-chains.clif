function %carry_into_shared_zero(i64, i64, i64, i64) -> i64, i64 {
block0(v0: i64, v1: i64, v2: i64, v3: i64):
    v4 = iconst.i64 0
    v5, v6 = uadd_overflow v0, v1
    v7, v8 = uadd_overflow_cin v2, v4, v6
    v9, v10 = uadd_overflow v7, v3
    v11, v12 = uadd_overflow_cin v5, v4, v10
    return v9, v11
}

