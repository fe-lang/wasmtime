function %chain(i64, i64, i64, i64) -> i64, i64, i8 {
block0(v0: i64, v1: i64, v2: i64, v3: i64):
    v4, v5 = uadd_overflow v0, v2
    v6, v7 = uadd_overflow_cin v1, v3, v5
    return v4, v6, v7
}

