function %carry_after_flags_write(i64, i64, i64) -> i64, i8 {
block0(v0: i64, v1: i64, v2: i64):
    v3, v4 = uadd_overflow v0, v1
    v5 = imul v2, v2
    v6, v7 = uadd_overflow_cin v5, v1, v4
    v8 = bxor v3, v6
    return v8, v7
}

