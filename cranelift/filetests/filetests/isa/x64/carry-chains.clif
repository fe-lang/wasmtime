function %borrow_chain_through_memory(i64, i64, i64) {
block0(v0: i64, v1: i64, v2: i64):
    v3 = load.i64 v0
    v4 = load.i64 v1
    v5, v6 = usub_overflow v3, v4
    store v5, v2
    v7 = load.i64 v0+8
    v8 = load.i64 v1+8
    v9, v10 = usub_overflow_bin v7, v8, v6
    store v9, v2+8
    return
}

