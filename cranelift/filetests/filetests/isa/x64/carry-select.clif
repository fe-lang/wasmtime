;; A zero alternative moves in with `movl`, which leaves the borrow in CF.
function %zero_alternative(i64, i64) -> i64 {
block0(v0: i64, v1: i64):
  v2, v3 = usub_overflow v0, v1
  v4 = uextend.i64 v3
  v5 = iconst.i64 0
  v6 = icmp eq v4, v5
  v7 = select v6, v2, v5
  return v7
}

