;   movq %rsi, 8(%rdi) ; trap: heap_oob
;   popq %rbp
;   retq


;; A saturating subtraction: the select takes the borrow from the flags and
;; zero from memory.
function %saturating_sub(i64, i64) -> i64 {
block0(v0: i64, v1: i64):
  v2, v3 = usub_overflow v0, v1
  v4 = iconst.i64 0
  v5 = select v3, v4, v2
  return v5
}

