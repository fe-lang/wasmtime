;   movq %rsp, %rbp
; block1: ; offset 0x4
;   subq %rsi, %rdi
;   movq %rdi, %rax
;   cmovbq 6(%rip), %rax
;   popq %rbp
;   retq
;   addb %al, (%rax)
;   addb %al, (%rax)
;   addb %al, (%rax)
;   addb %al, (%rax)
;   addb %al, (%rax)
;   addb %al, (%rax)

function %saturating_sub_masked(i64, i64) -> i64 {
block0(v0: i64, v1: i64):
  v2, v3 = usub_overflow v0, v1
  v4 = iconst.i8 1
  v5 = band v3, v4
  v6 = iconst.i64 0
  v7 = select v5, v6, v2
  return v7
}

