;; A stack slot address inside the pair, between the links of both chains.
function %stack_addr_inside_pair(i64, i64, i64, i64, i64, i64) -> i64, i64, i64, i64 {
    ss0 = explicit_slot 8
    ss1 = explicit_slot 8
block0(v0: i64, v1: i64, v2: i64, v3: i64, v4: i64, v5: i64):
    v6, v7 = uadd_overflow v0, v1
    v8, v9 = uadd_overflow v2, v3
    v10 = stack_addr.i64 ss0
    v11 = stack_addr.i64 ss1
    store notrap v10, v11
    v12, v13 = uadd_overflow_cin v4, v5, v7
    v14, v15 = uadd_overflow_cin v4, v1, v9
    store notrap v12, v10
    v16 = load.i64 notrap v11
    v17 = load.i64 notrap v16
    v18 = bxor v6, v8
    return v18, v17, v12, v14
}

