;; A stack slot address or a zero between the links of a chain and a second
;; chain's start leave the flags alone, so the two interleave; the link that
;; adds a constant before the pair stays an `adcx`.
function %constant_link_past_stack_addr(i64, i64, i64, i64, i64) -> i64, i64, i64, i64 {
    ss0 = explicit_slot 8
    ss1 = explicit_slot 8
block0(v0: i64, v1: i64, v2: i64, v3: i64, v4: i64):
    v5, v6 = uadd_overflow v0, v1
    v7 = iconst.i64 1
    v8, v9 = uadd_overflow_cin v2, v7, v6
    v10 = stack_addr.i64 ss0
    v11 = stack_addr.i64 ss1
    store notrap v10, v11
    v12, v13 = uadd_overflow v3, v4
    v14 = iconst.i64 0
    v15, v16 = uadd_overflow_cin v5, v14, v9
    v17, v18 = uadd_overflow_cin v8, v14, v13
    v19 = load.i64 notrap v11
    v20 = load.i64 notrap v19
    return v12, v15, v17, v20
}

