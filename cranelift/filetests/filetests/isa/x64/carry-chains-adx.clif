;; A zero inside the pair, between the links of both chains.
function %zero_inside_pair(i64, i64, i64, i64, i64, i64) -> i64, i64, i64, i64 {
block0(v0: i64, v1: i64, v2: i64, v3: i64, v4: i64, v5: i64):
    v6, v7 = uadd_overflow v0, v1
    v8, v9 = uadd_overflow v2, v3
    v10 = iconst.i64 0
    v11, v12 = uadd_overflow_cin v4, v5, v7
    v13, v14 = uadd_overflow_cin v4, v1, v9
    v15 = bxor v6, v8
    return v15, v10, v11, v13
}

