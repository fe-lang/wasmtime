;; A zero addend while both chains are in flight takes the pair's zero
;; register, which the `xor` clearing the flags set: here the CF chain ends
;; on the second product's high word before the OF chain adds it.
function %zero_addend_in_pair(i64, i64, i64, i64, i64, i64) -> i64, i64, i64, i64 {
block0(v0: i64, v1: i64, v2: i64, v3: i64, v4: i64, v5: i64):
    v6 = uextend.i128 v0
    v7 = uextend.i128 v2
    v8 = imul v6, v7
    v9, v10 = isplit v8
    v11, v12 = uadd_overflow v3, v9
    v13, v14 = uadd_overflow v4, v10
    v15 = uextend.i128 v1
    v16 = imul v15, v7
    v17, v18 = isplit v16
    v19, v20 = uadd_overflow_cin v13, v17, v12
    v21 = iconst.i64 0
    v22, v23 = uadd_overflow_cin v18, v21, v20
    v24, v25 = uadd_overflow_cin v5, v22, v14
    v26 = uextend.i64 v25
    return v11, v19, v24, v26
}

