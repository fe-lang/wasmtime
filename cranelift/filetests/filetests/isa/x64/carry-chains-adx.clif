;; A zero between the first ops of an interleaved pair moves in with `movl`:
;; the `adox` takes OF clear from the first op's `xor`.
function %zero_at_pair_start(i64, i64, i64, i64, i64, i64) -> i64, i64, i64, i64 {
block0(v0: i64, v1: i64, v2: i64, v3: i64, v4: i64, v5: i64):
    v6, v7 = uadd_overflow v0, v1
    v8 = iconst.i64 0
    v9, v10 = uadd_overflow v2, v3
    v11, v12 = uadd_overflow_cin v4, v5, v10
    jump block1

block1:
    v13, v14 = uadd_overflow_cin v6, v5, v7
    return v9, v8, v11, v13
}

