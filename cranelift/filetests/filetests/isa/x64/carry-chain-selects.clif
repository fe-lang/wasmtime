;; A select of a chain's own result cannot move before the chain.
function %select_of_chain(i64, i64, i64, i64, i64) -> i64 {
block0(v0: i64, v1: i64, v2: i64, v3: i64, v4: i64):
    v5, v6 = uadd_overflow v0, v1
    v7 = iconst.i64 0
    v8 = icmp ne v4, v7
    v9 = select v8, v5, v2
    v10, v11 = uadd_overflow_cin v9, v3, v6
    return v10
}

