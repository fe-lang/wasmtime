test compile precise-output
set opt_level=speed
target x86_64

;; A modular reduction's selects feed an addition chain one limb at a time.
;; The egraph pass puts each select right before its use, between the links
;; of the chain; they move back before it, share one compare, and the carry
;; stays in the flags.
function %selected_sum(i64, i64, i64, i64, i64, i64, i64, i64) {
block0(v0: i64, v1: i64, v2: i64, v3: i64, v4: i64, v5: i64, v6: i64, v7: i64):
    v8 = iconst.i64 1
    v9 = icmp eq v7, v8
    v10 = select v9, v0, v1
    v11 = select v9, v2, v3
    v12 = select v9, v4, v5
    v13 = load.i64 notrap v6
    v14 = load.i64 notrap v6+8
    v15 = load.i64 notrap v6+16
    v16, v17 = uadd_overflow v10, v13
    v18, v19 = uadd_overflow_cin v11, v14, v17
    v20, v21 = uadd_overflow_cin v12, v15, v19
    store v16, v6
    store v18, v6+8
    store v20, v6+16
    return
}

