test compile precise-output
target x86_64

;; Each early exit passes a value to the shared exit over a critical edge. The
;; edge blocks to the branches' first targets go after the hot blocks, so the
;; path through the last targets falls through without a taken branch.
function %early_exits(i64, i64) -> i64 {
block0(v0: i64, v1: i64):
    v2 = iconst.i64 0
    v3 = icmp eq v0, v2
    brif v3, block3(v1), block1

block1:
    v4 = iadd v0, v1
    v5 = iconst.i64 7
    v6 = icmp eq v4, v5
    brif v6, block3(v0), block2

block2:
    v7 = imul v4, v1
    jump block3(v7)

block3(v8: i64):
    return v8
}

