test compile precise-output
set enable_llvm_abi_extensions=true
target x86_64

;; Selects on one condition with only stores between share one compare.

function %selects_share_compare(i64, i64, i64, i64, i64) {
block0(v0: i64, v1: i64, v2: i64, v3: i64, v4: i64):
    v5 = iconst.i64 1
    v6 = icmp eq v0, v5
    v7 = select v6, v1, v2
    store v7, v4
    v8 = select v6, v2, v3
    store v8, v4+8
    v9 = select v6, v3, v1
    store v9, v4+16
    return
}

