;; A zero before the borrow stays an `xor`.

function %zero_before_borrow(i64, i64) -> i64 {
block0(v0: i64, v1: i64):
    v2 = iconst.i64 0
    v3, v4 = usub_overflow v0, v1
    v5 = select v4, v3, v2
    return v5
}

