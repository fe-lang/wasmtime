;; Zeros of 8, 16 and 32 bits between a borrow and the selects on it, before
;; the first and between them, move in with `movl`.

function %narrow_zeros(i32, i32, i8, i16) -> i8, i16, i32 {
block0(v0: i32, v1: i32, v2: i8, v3: i16):
    v4, v5 = usub_overflow v0, v1
    v6 = iconst.i8 0
    v7 = select v5, v2, v6
    v8 = iconst.i16 0
    v9 = select v5, v3, v8
    v10 = iconst.i32 0
    v11 = select v5, v4, v10
    return v7, v9, v11
}

