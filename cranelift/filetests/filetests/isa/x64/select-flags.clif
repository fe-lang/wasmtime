;; An addition, a call or a compare on another condition between a borrow
;; and the select on it writes the flags: the borrow is kept with `setb`, and
;; the zero is an `xor`.

function %zero_and_add_between(i64, i64, i64) -> i64, i64 {
block0(v0: i64, v1: i64, v2: i64):
    v3, v4 = usub_overflow v0, v1
    v5 = iadd v2, v2
    v6 = iconst.i64 0
    v7 = select v4, v3, v6
    return v7, v5
}

