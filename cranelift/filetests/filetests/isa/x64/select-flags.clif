;   movq %rdx, %r9
;   cmoveq %rsi, %r9
;   movq %r9, (%r8) ; trap: heap_oob
;   movq %rcx, %r10
;   cmoveq %rdx, %r10
;   movq %r10, 8(%r8) ; trap: heap_oob
;   cmoveq %rcx, %rsi
;   movq %rsi, 0x10(%r8) ; trap: heap_oob
;   popq %rbp
;   retq

;; An addition between them writes the flags, so the second compares again.

function %add_between(i64, i64, i64, i64) -> i64, i64 {
block0(v0: i64, v1: i64, v2: i64, v3: i64):
    v4 = icmp ult v0, v1
    v5 = select v4, v1, v2
    v6 = iadd v5, v3
    v7 = select v4, v6, v3
    return v5, v7
}

