;; A 128-bit zero zeroes its high half with `xor`, so the select after it
;; compares again.

function %wide_zero_between(i64, i64, i64, i64) -> i64, i64 {
    ss0 = explicit_slot 16
block0(v0: i64, v1: i64, v2: i64, v3: i64):
    v4 = iconst.i64 1
    v5 = band v0, v4
    v6 = select v5, v1, v2
    v7 = iconst.i64 0
    v8 = uextend.i128 v7
    v9 = select v5, v3, v1
    v10 = stack_addr.i64 ss0
    store notrap v8, v10
    v11 = load.i64 notrap v10+8
    v12 = iadd v9, v11
    return v6, v12
}

