;; A narrow `bt` condition reused across a zero.

function %bit_test_past_zero(i8, i8, i64, i64, i64) -> i64, i64 {
block0(v0: i8, v1: i8, v2: i64, v3: i64, v4: i64):
    v5 = iconst.i8 1
    v6 = ishl v5, v1
    v7 = band v0, v6
    v8 = select v7, v2, v3
    v9 = iconst.i64 0
    v10 = select v7, v4, v9
    return v8, v10
}

