;; An addition between them writes the flags, so the second compares again.

function %add_between(i64, i64, i64, i64) -> i64, i64 {
block0(v0: i64, v1: i64, v2: i64, v3: i64):
    v4 = icmp ult v0, v1
    v5 = select v4, v1, v2
    v6 = iadd v5, v3
    v7 = select v4, v6, v3
    return v5, v7
}

