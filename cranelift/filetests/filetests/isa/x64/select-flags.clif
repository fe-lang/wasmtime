function %zero_and_compare_between(i64, i64, i64) -> i64, i64 {
block0(v0: i64, v1: i64, v2: i64):
    v3, v4 = usub_overflow v0, v1
    v5 = icmp ult v0, v2
    v6 = select v5, v2, v0
    v7 = iconst.i64 0
    v8 = select v4, v3, v7
    return v8, v6
}

