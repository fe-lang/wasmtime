;; A select that lowering skips, whose only user is unused, compares nothing,
;; so the select after it on the same condition compares again.

function %skipped_select_between(i64, i64, i64, i64) -> i64, i64 {
block0(v0: i64, v1: i64, v2: i64, v3: i64):
    v4 = iconst.i64 1
    v5 = band v0, v4
    v6 = select v5, v1, v2
    v7 = iconst.i64 2
    v8 = band v0, v7
    v9 = select v8, v1, v6
    v10 = select v8, v6, v3
    v11 = iadd v9, v9
    return v6, v10
}

