;; The select between the zero and the select taking the flags of the first
;; one, used only by unused code, is skipped: the zero is a `movl`.

function %zero_before_skipped_select(i64, i64, i64, i64) -> i64, i64 {
block0(v0: i64, v1: i64, v2: i64, v3: i64):
    v4 = iconst.i64 1
    v5 = band v0, v4
    v6 = iconst.i64 2
    v7 = band v0, v6
    v8 = select v5, v1, v2
    v9 = iconst.i64 0
    v10 = select v7, v1, v8
    v11 = select v5, v3, v9
    v12 = iadd v10, v10
    return v8, v11
}

