;; A zero between selects on one condition moves in with `movl`, which leaves
;; the flags alone.

function %zero_between(i64, i64, i64, i64) -> i64, i64 {
block0(v0: i64, v1: i64, v2: i64, v3: i64):
    v4 = iconst.i64 1
    v5 = band v0, v4
    v6 = select v5, v1, v2
    v7 = iconst.i64 0
    v8 = select v5, v3, v7
    return v6, v8
}

