function %zero_and_call_between(i64, i64) -> i64 {
    fn0 = %g()
block0(v0: i64, v1: i64):
    v2, v3 = usub_overflow v0, v1
    call fn0()
    v4 = iconst.i64 0
    v5 = select v3, v2, v4
    return v5
}

