;; Stack slot addresses that are selected are `lea`s between the selects.

function %stack_addrs_between(i64, i64, i64) -> i64, i64 {
    ss0 = explicit_slot 8
    ss1 = explicit_slot 8
block0(v0: i64, v1: i64, v2: i64):
    v3 = iconst.i64 1
    v4 = icmp eq v0, v3
    v5 = select v4, v1, v2
    v6 = stack_addr.i64 ss0
    v7 = stack_addr.i64 ss1
    v8 = select v4, v6, v7
    store notrap v1, v6
    store notrap v2, v7
    v9 = load.i64 notrap v8
    return v5, v9
}

