;; So does a stack slot address, an `lea`.

function %stack_addr_between(i64, i64, i64, i64) -> i64 {
    ss0 = explicit_slot 16
block0(v0: i64, v1: i64, v2: i64, v3: i64):
    v4 = iconst.i64 1
    v5 = icmp eq v0, v4
    v6 = select v5, v1, v2
    v7 = stack_addr.i64 ss0
    store notrap v6, v7
    v8 = select v5, v2, v3
    store notrap v8, v7+8
    v9 = load.i64 notrap v7
    v10 = load.i64 notrap v7+8
    v11 = iadd v9, v10
    return v11
}

