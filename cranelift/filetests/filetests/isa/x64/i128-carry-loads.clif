test compile precise-output
target x86_64

;; An i256 addition of two words in memory: each half of the second operand's
;; `iconcat` is a load that sinks into its `add` or `adc`.
function %add_words(i64) {
block0(v0: i64):
    v1 = load.i64 notrap v0
    v2 = load.i64 notrap v0+8
    v3 = load.i64 notrap v0+16
    v4 = load.i64 notrap v0+24
    v5 = load.i64 notrap v0+32
    v6 = load.i64 notrap v0+40
    v7 = load.i64 notrap v0+48
    v8 = load.i64 notrap v0+56
    v9 = iconcat v1, v2
    v10 = iconcat v3, v4
    v11 = iconcat v5, v6
    v12 = iconcat v7, v8
    v13, v14 = uadd_overflow v9, v11
    v15, v16 = uadd_overflow_cin v10, v12, v14
    v17, v18 = isplit v13
    v19, v20 = isplit v15
    store v17, v0
    store v18, v0+8
    store v19, v0+16
    store v20, v0+24
    return
}

