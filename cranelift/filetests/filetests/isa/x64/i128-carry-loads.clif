;; An i128 subtraction whose second operand is a load of its own: the load's
;; halves are the `sbb`s' operands.
function %sub_loaded(i64, i64, i8) -> i8 {
block0(v0: i64, v1: i64, v2: i8):
    v3 = load.i128 notrap v0
    v4 = load.i128 notrap v1
    v5, v6 = usub_overflow_bin v3, v4, v2
    store v5, v0
    return v6
}

