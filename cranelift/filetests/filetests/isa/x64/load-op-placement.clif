test compile precise-output
set opt_level=speed
target x86_64

;; Each load runs next to its `bxor`: the first chain's loads move down to it,
;; and the second chain, whose loads cannot pass the first store, moves up to
;; them. So both chains fold loads into memory operands, and the second
;; chain's loads are not live across the first store.
function %xor_chains(i64, i64) {
block0(v0: i64, v1: i64):
    v2 = load.i64 notrap v0
    v3 = load.i64 notrap v0+8
    v4 = load.i64 notrap v0+16
    v5 = load.i64 notrap v0+24
    v6 = load.i64 notrap v0+32
    v7 = load.i64 notrap v0+40
    v8 = bxor v2, v3
    v9 = bxor v8, v4
    v10 = bxor v5, v6
    v11 = bxor v10, v7
    store notrap v9, v1
    store notrap v11, v1+8
    return
}

