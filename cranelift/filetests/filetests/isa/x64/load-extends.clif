function %load_uextend_bswap_i32_i64_after_branch(i64, i8) -> i64 {
block0(v0: i64, v1: i8):
  v2 = load.i32 v0
  brif v1, block1, block2

block1:
  v3 = bswap v2
  v4 = uextend.i64 v3
  return v4

block2:
