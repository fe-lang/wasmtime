;; Nor the `xor`s of a 128-bit equality, which the `or` setting ZF combines.

function %wide_equality(i128, i128, i64, i64, i64) -> i64, i64 {
block0(v0: i128, v1: i128, v2: i64, v3: i64, v4: i64):
    v5 = icmp eq v0, v1
    v6 = uextend.i64 v5
    v7 = select v6, v2, v3
    v8 = select v6, v4, v2
    return v7, v8
}

