test compile precise-output
set enable_llvm_abi_extensions=true
target x86_64

;; A select on the condition of the select before it emits none of the
;; condition's instructions: the `and` wrapping a narrow `bt`'s bit index
;; would clear CF.

function %narrow_bit_test(i8, i8, i64, i64, i64) -> i64, i64 {
block0(v0: i8, v1: i8, v2: i64, v3: i64, v4: i64):
    v5 = iconst.i8 1
    v6 = ishl v5, v1
    v7 = band v0, v6
    v8 = select v7, v2, v3
    v9 = select v7, v4, v2
    return v8, v9
}

