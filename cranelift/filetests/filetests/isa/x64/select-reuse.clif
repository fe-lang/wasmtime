;   pushq %rbp
;   movq %rsp, %rbp
; block0:
;   andl $0x7, %esi
;   btl %esi, %edi
;   movq %rcx, %rax
;   cmovbq %rdx, %rax
;   cmovbq %r8, %rdx
;   popq %rbp
;   retq
;
; Disassembled:
; block0: ; offset 0x0
;   pushq %rbp
;   movq %rsp, %rbp
; block1: ; offset 0x4
;   andl $7, %esi
;   btl %esi, %edi
;   movq %rcx, %rax
;   cmovbq %rdx, %rax
;   cmovbq %r8, %rdx
;   popq %rbp
;   retq

function %narrow_bit_test_compared(i16, i16, i64, i64, i64) -> i64, i64 {
block0(v0: i16, v1: i16, v2: i64, v3: i64, v4: i64):
    v5 = iconst.i16 1
    v6 = ishl v5, v1
    v7 = band v0, v6
    v8 = iconst.i16 0
    v9 = icmp ne v7, v8
    v10 = select v9, v2, v3
    v11 = select v9, v4, v2
    return v10, v11
}

