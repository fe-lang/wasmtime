; block3: ; offset 0x20
;   popq %rbp
;   retq

;; A carry used besides the branch stays in a register too.

function %carry_used_twice(i64, i64) -> i64, i8 {
block0(v0: i64, v1: i64):
    v2, v3 = usub_overflow v0, v1
    brif v3, block1, block2

block1:
    return v2, v3

block2:
    v4 = iconst.i8 0
    return v2, v4
}

