;   movq %rsp, %rbp
; block1: ; offset 0x4
;   addq %rsi, %rdi
;   movq (%rdx), %rax
;   jb 0x15
; block2: ; offset 0x10
;   movq %rdi, %rax
;   popq %rbp
;   retq
; block3: ; offset 0x15
;   popq %rbp
;   retq

;; An addition between them writes the flags, so the carry is kept.

function %carry_past_add(i64, i64, i64) -> i64 {
block0(v0: i64, v1: i64, v2: i64):
    v3, v4 = uadd_overflow v0, v1
    v5 = iadd v2, v3
    brif v4, block1, block2

block1:
    return v5

block2:
    return v3
}

