;; A branch on a borrow whose difference goes unused still subtracts.

function %borrow_of_unused_difference(i64, i64) -> i64 {
block0(v0: i64, v1: i64):
    v2, v3 = usub_overflow v0, v1
    brif v3, block1, block2
block1:
    v4 = iconst.i64 1
    return v4
block2:
    v5 = iconst.i64 2
    return v5
}

