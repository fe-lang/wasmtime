;; A sunk stack-slot load is only aligned when its flags say so: SSE memory
;; operands fault on unaligned addresses.

function %sunk_slot_load_unaligned() -> f64 {
    ss0 = explicit_slot 24

block0:
    v0 = stack_addr.i64 ss0+1
    v1 = load.f64x2 notrap v0
    v2 = extractlane v1, 1
    return v2
}

; VCode:
;   pushq %rbp
;   movq %rsp, %rbp
;   subq $0x20, %rsp
; block0:
;   movdqu <offset:1>+1(%rsp), %xmm0
;   pshufd $0xee, %xmm0, %xmm0
;   addq $0x20, %rsp
;   popq %rbp
;   retq
;
; Disassembled:
; block0: ; offset 0x0
;   pushq %rbp
;   movq %rsp, %rbp
;   subq $0x20, %rsp
; block1: ; offset 0x8
;   movdqu 1(%rsp), %xmm0
;   pshufd $0xee, %xmm0, %xmm0
;   addq $0x20, %rsp
;   popq %rbp
;   retq

function %sunk_slot_load_aligned() -> f64 {
    ss0 = explicit_slot 32, align = 16

block0:
    v0 = stack_addr.i64 ss0+16
    v1 = load.f64x2 notrap aligned v0
    v2 = extractlane v1, 1
    return v2
}

