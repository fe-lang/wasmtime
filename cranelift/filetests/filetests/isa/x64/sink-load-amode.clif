test compile precise-output
set opt_level=speed
target x86_64

;; A load sunk into an instruction folds a constant-offset `iadd` whose base is
;; itself an `iadd` into the addressing mode, like a plain load does.

function %iadd_i128_sunk_loads(i64, i64) -> i64, i64 {
block0(v0: i64, v1: i64):
    v2 = iconst.i64 5
    v3 = ishl v1, v2
    v4 = iadd v0, v3
    v5 = iconst.i64 -64
    v6 = iadd v4, v5
    v7 = load.i64 v4
    v8 = load.i64 v4+8
    v9 = iconcat v7, v8
    v10 = load.i64 v6
    v11 = load.i64 v6+8
    v12 = iconcat v10, v11
    v13 = iadd v9, v12
    v14, v15 = isplit v13
    return v14, v15
}

; VCode:
;   pushq %rbp
;   movq %rsp, %rbp
; block0:
;   shlq $0x5, %rsi
;   movq (%rdi, %rsi), %rax
;   movq 8(%rdi, %rsi), %rdx
;   movq -0x40(%rdi, %rsi), %r8
;   addq %r8, %rax
;   adcq -0x38(%rdi, %rsi), %rdx
;   popq %rbp
;   retq
;
; Disassembled:
; block0: ; offset 0x0
;   pushq %rbp
;   movq %rsp, %rbp
; block1: ; offset 0x4
;   shlq $5, %rsi
;   movq (%rdi, %rsi), %rax ; trap: heap_oob
;   movq 8(%rdi, %rsi), %rdx ; trap: heap_oob
;   movq -0x40(%rdi, %rsi), %r8 ; trap: heap_oob
;   addq %r8, %rax
;   adcq -0x38(%rdi, %rsi), %rdx ; trap: heap_oob
;   popq %rbp
;   retq

function %iadd_i64_sunk_load(i64, i64, i64) -> i64 {
block0(v0: i64, v1: i64, v2: i64):
    v3 = iconst.i64 5
    v4 = ishl v1, v3
    v5 = iadd v0, v4
    v6 = iconst.i64 -64
    v7 = iadd v5, v6
    v8 = load.i64 v7+24
    v9 = iadd v2, v8
    return v9
}

