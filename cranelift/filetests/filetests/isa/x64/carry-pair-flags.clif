;; A borrow chain starting while an addition chain is in flight does not
;; pair with it, nor with the addition chain after it.
function %borrow_between_adds(i64, i64, i64, i64, i64) -> i64, i64, i64, i64 {
block0(v0: i64, v1: i64, v2: i64, v3: i64, v4: i64):
    v5, v6 = uadd_overflow v0, v1
    v7, v8 = usub_overflow v2, v3
    v9, v10 = uadd_overflow v4, v0
    v11, v12 = uadd_overflow_cin v5, v1, v6
    v13, v14 = usub_overflow_bin v7, v3, v8
    v15, v16 = uadd_overflow_cin v9, v1, v10
    return v11, v13, v15, v5
}

