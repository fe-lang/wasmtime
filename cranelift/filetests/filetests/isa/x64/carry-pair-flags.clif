;; A chain that never pairs adds a constant with a plain `adc`.
function %unpaired_constant_link(i64, i64, i64) -> i64, i64, i8 {
block0(v0: i64, v1: i64, v2: i64):
    v3, v4 = uadd_overflow v0, v1
    v5 = iconst.i64 -2
    v6, v7 = uadd_overflow_cin v2, v5, v4
    return v3, v6, v7
}

