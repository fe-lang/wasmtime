;; After the pair's OF chain ends, a link adding a constant is a plain `adc`
;; and the next a register `adcx`; a third chain does not pair with the
;; first, which has had its pair.
function %plain_link_after_pair(i64, i64, i64, i64, i64, i64) -> i64, i64, i64, i64 {
block0(v0: i64, v1: i64, v2: i64, v3: i64, v4: i64, v5: i64):
    v6, v7 = uadd_overflow v0, v1
    v8, v9 = uadd_overflow v2, v3
    v10, v11 = uadd_overflow_cin v4, v1, v7
    v12, v13 = uadd_overflow_cin v4, v3, v9
    v14 = iconst.i64 1
    v15, v16 = uadd_overflow_cin v10, v14, v11
    v17, v18 = uadd_overflow_cin v15, v2, v16
    v19, v20 = uadd_overflow v5, v0
    v21, v22 = uadd_overflow_cin v19, v1, v20
    v23 = uextend.i64 v18
    v24 = iadd v21, v23
    return v8, v12, v17, v24
}

