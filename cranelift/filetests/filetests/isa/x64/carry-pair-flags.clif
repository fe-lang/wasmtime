test compile precise-output
set enable_multi_ret_implicit_sret
target x86_64 has_bmi2 has_adx

;; A link of a carry chain that adds a constant, before a second chain
;; starts and the two interleave, stays an `adcx`: an `adc` would write OF
;; between the `xor` that clears it and the second chain's first `adox`.
function %constant_link_before_pair(i64, i64, i64, i64, i64) -> i64, i64, i64 {
block0(v0: i64, v1: i64, v2: i64, v3: i64, v4: i64):
    v5, v6 = uadd_overflow v0, v1
    v7 = iconst.i64 1
    v8, v9 = uadd_overflow_cin v2, v7, v6
    v10 = iconst.i64 0
    v11, v12 = uadd_overflow v3, v4
    v13, v14 = uadd_overflow_cin v5, v10, v9
    v15, v16 = uadd_overflow_cin v8, v10, v12
    return v11, v13, v15
}

