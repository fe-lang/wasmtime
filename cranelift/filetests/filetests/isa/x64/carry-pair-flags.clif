;; A link adding zero, the pair's zero register, or a negative constant, a
;; sign-extended `movq`, before the pair is an `adcx` too.
function %zero_link_before_pair(i64, i64, i64, i64, i64) -> i64, i64, i64 {
block0(v0: i64, v1: i64, v2: i64, v3: i64, v4: i64):
    v5, v6 = uadd_overflow v0, v1
    v7 = iconst.i64 0
    v8, v9 = uadd_overflow_cin v2, v7, v6
    v10, v11 = uadd_overflow v3, v4
    v12, v13 = uadd_overflow_cin v5, v7, v9
    v14, v15 = uadd_overflow_cin v8, v7, v11
    return v10, v12, v14
}

