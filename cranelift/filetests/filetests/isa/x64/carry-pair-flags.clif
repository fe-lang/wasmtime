;; A third chain starting while the pair is in flight ends both; their next
;; links take their carries from registers.
function %third_chain_in_pair(i64, i64, i64, i64, i64, i64) -> i64, i64, i64, i64 {
block0(v0: i64, v1: i64, v2: i64, v3: i64, v4: i64, v5: i64):
    v6, v7 = uadd_overflow v0, v1
    v8, v9 = uadd_overflow v2, v3
    v10, v11 = uadd_overflow v4, v5
    v12, v13 = uadd_overflow_cin v6, v1, v7
    v14, v15 = uadd_overflow_cin v8, v3, v9
    v16, v17 = uadd_overflow_cin v10, v5, v11
    v18 = bxor v12, v14
    return v18, v16, v6, v8
}

