test compile precise-output
target aarch64

function %uadd_overflow_cin_i64(i64, i64, i8) -> i64, i8 {
block0(v0: i64, v1: i64, v2: i8):
    v3, v4 = uadd_overflow_cin v0, v1, v2
    return v3, v4
}

