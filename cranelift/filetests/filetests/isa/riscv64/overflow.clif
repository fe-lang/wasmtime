test compile precise-output
set unwind_info=false
set enable_multi_ret_implicit_sret
target riscv64-unknown-none-elf use_soft_float_abi has_a=false has_f=false has_d=false has_zicsr=false has_zifencei=false

function %uadd_i8(i8, i8) -> i8, i8 {
block0(v0: i8, v1: i8):
    v2, v3 = uadd_overflow v0, v1
    return v2, v3
}

; VCode:
; block0:
;   andi a0,a0,255
;   andi a1,a1,255
;   add a0,a0,a1
;   srli a1,a0,8
;   ret
;
; Disassembled:
; block0: ; offset 0x0
;   andi a0, a0, 0xff
;   andi a1, a1, 0xff
;   add a0, a0, a1
;   srli a1, a0, 8
;   ret

