function %stack_f64(i64, f64, f32, i64, i64, i64, i64, i64, f64) -> f64 {
block0(v0: i64, v1: f64, v2: f32, v3: i64, v4: i64, v5: i64, v6: i64, v7: i64, v8: f64):
    return v8
}

