test compile precise-output
set enable_multi_ret_implicit_sret
set unwind_info=false
target riscv64im-unknown-none-elf

function %id_f64(f64) -> f64 {
block0(v0: f64):
    return v0
}

; VCode:
; block0:
;   ret
;
; Disassembled:
; block0: ; offset 0x0
;   ret

function %id_f32(f32) -> f32 {
block0(v0: f32):
    return v0
}

; VCode:
; block0:
;   ret
;
; Disassembled:
; block0: ; offset 0x0
;   ret

function %call_f64(f64, f64) -> f64 {
    fn0 = %callee(f64, f64) -> f64

block0(v0: f64, v1: f64):
    v2 = call fn0(v0, v1)
    return v2
}

