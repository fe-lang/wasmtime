test compile precise-output
set unwind_info=false
set enable_multi_ret_implicit_sret
target riscv64

function %uadd_overflow_cin_i64(i64, i64, i8) -> i64, i8 {
block0(v0: i64, v1: i64, v2: i8):
    v3, v4 = uadd_overflow_cin v0, v1, v2
    return v3, v4
}

; VCode:
; block0:
;   andi a2,a2,255
;   sltu a2,zero,a2
;   add a1,a0,a1
;   mv a5,a0
;   add a0,a1,a2
;   sltu a2,a1,a5
;   sltu a4,a0,a1
;   or a1,a2,a4
;   ret
;
; Disassembled:
; block0: ; offset 0x0
;   andi a2, a2, 0xff
;   snez a2, a2
;   add a1, a0, a1
;   mv a5, a0
;   add a0, a1, a2
;   sltu a2, a1, a5
;   sltu a4, a0, a1
;   or a1, a2, a4
;   ret

