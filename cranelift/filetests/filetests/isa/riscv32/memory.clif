test compile precise-output
set unwind_info=false
target riscv32im-unknown-none-elf

function %load_i32(i32) -> i32 {
block0(v0: i32):
  v1 = load.i32 v0
  return v1
}

; VCode:
; block0:
;   lw a0,0(a0)
;   ret
