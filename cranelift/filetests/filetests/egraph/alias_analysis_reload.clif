test optimize
set opt_level=speed
target x86_64

;; A second load of the same address with no store between reuses the first
;; load's value, unless it is a reload, which reads memory again.
function %reuses(i64) -> i64 {
block0(v0: i64):
    v1 = load.i64 notrap v0
    v2 = load.i64 notrap v0
    v3 = iadd v1, v2
    return v3
}

; check: v1 = load.i64 notrap v0
; check: v3 = iadd v1, v1
; check: return v3

function %reloads(i64) -> i64 {
block0(v0: i64):
    v1 = load.i64 notrap v0
    v2 = load.i64 notrap reload v0
    v3 = iadd v1, v2
    v4 = load.i64 notrap reload v0
    v5 = iadd v3, v4
    return v5
}

; check: v1 = load.i64 notrap v0
; check: v2 = load.i64 notrap reload v0
; check: v4 = load.i64 notrap reload v0
