;; Lane 5 was just written: loading it again could run before the store
;; finishes and flush the pipeline, so it keeps its value; others reload.

function %stored_before_load(i64, i64) -> i64 {
    ss0 = explicit_slot 128
block0(v0: i64, v1: i64):
    istore8 notrap aligned v1, v0+40
    v2 = load.i64 notrap aligned v0+0
    v3 = load.i64 notrap aligned v0+8
