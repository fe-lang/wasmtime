    store notrap aligned v47, v33+16
    v48 = bxor v3, v32
    store notrap aligned v48, v33+8
    v49 = bxor v2, v32
    store notrap aligned v49, v33+0
    v50 = load.i64 notrap aligned v33+8
    return v50
}

