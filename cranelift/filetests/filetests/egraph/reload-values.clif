    v12 = load.i64 notrap aligned v0+80
    v13 = load.i64 notrap aligned v0+88
    v14 = load.i64 notrap aligned v0+96
    v15 = load.i64 notrap aligned v0+104
    v16 = load.i64 notrap aligned v0+112
    v17 = load.i64 notrap aligned v0+120
    v18 = iadd v2, v3
    v19 = iadd v18, v4
    v20 = iadd v19, v5
    v21 = iadd v20, v6
    v22 = iadd v21, v7
    v23 = iadd v22, v8
    v24 = iadd v23, v9
    v25 = iadd v24, v10
    v26 = iadd v25, v11
    v27 = iadd v26, v12
    v28 = iadd v27, v13
    v29 = iadd v28, v14
    v30 = iadd v29, v15
    v31 = iadd v30, v16
    v32 = iadd v31, v17
    v33 = stack_addr.i64 ss0
    v34 = bxor v17, v32
    store notrap aligned v34, v33+120
    v35 = bxor v16, v32
    store notrap aligned v35, v33+112
    v36 = bxor v15, v32
    store notrap aligned v36, v33+104
    v37 = bxor v14, v32
    store notrap aligned v37, v33+96
    v38 = bxor v13, v32
    store notrap aligned v38, v33+88
    v39 = bxor v12, v32
    store notrap aligned v39, v33+80
    v40 = bxor v11, v32
    store notrap aligned v40, v33+72
    v41 = bxor v10, v32
    store notrap aligned v41, v33+64
    v42 = bxor v9, v32
    store notrap aligned v42, v33+56
    v43 = bxor v8, v32
    store notrap aligned v43, v33+48
    v44 = bxor v7, v32
    store notrap aligned v44, v33+40
    v45 = bxor v6, v32
    store notrap aligned v45, v33+32
    v46 = bxor v5, v32
