test optimize precise-output
set opt_level=speed
target x86_64

;; Sixteen loaded values summed and reused: past the sum, more are live than
;; registers, so later uses load them again.

function %reused_after_sum(i64) -> i64 {
    ss0 = explicit_slot 128
block0(v0: i64):
    v1 = load.i64 notrap aligned v0+0
    v2 = load.i64 notrap aligned v0+8
    v3 = load.i64 notrap aligned v0+16
    v4 = load.i64 notrap aligned v0+24
    v5 = load.i64 notrap aligned v0+32
    v6 = load.i64 notrap aligned v0+40
    v7 = load.i64 notrap aligned v0+48
    v8 = load.i64 notrap aligned v0+56
    v9 = load.i64 notrap aligned v0+64
    v10 = load.i64 notrap aligned v0+72
    v11 = load.i64 notrap aligned v0+80
    v12 = load.i64 notrap aligned v0+88
    v13 = load.i64 notrap aligned v0+96
    v14 = load.i64 notrap aligned v0+104
    v15 = load.i64 notrap aligned v0+112
    v16 = load.i64 notrap aligned v0+120
    v17 = iadd v1, v2
    v18 = iadd v17, v3
    v19 = iadd v18, v4
    v20 = iadd v19, v5
    v21 = iadd v20, v6
    v22 = iadd v21, v7
    v23 = iadd v22, v8
    v24 = iadd v23, v9
    v25 = iadd v24, v10
    v26 = iadd v25, v11
    v27 = iadd v26, v12
    v28 = iadd v27, v13
    v29 = iadd v28, v14
    v30 = iadd v29, v15
    v31 = iadd v30, v16
    v32 = stack_addr.i64 ss0
    v33 = bxor v1, v31
    store notrap aligned v33, v32+0
    v34 = bxor v2, v31
    store notrap aligned v34, v32+8
    v35 = bxor v3, v31
    store notrap aligned v35, v32+16
    v36 = bxor v4, v31
    store notrap aligned v36, v32+24
    v37 = bxor v5, v31
    store notrap aligned v37, v32+32
    v38 = bxor v6, v31
    store notrap aligned v38, v32+40
    v39 = bxor v7, v31
    store notrap aligned v39, v32+48
    v40 = bxor v8, v31
    store notrap aligned v40, v32+56
    v41 = bxor v9, v31
    store notrap aligned v41, v32+64
    v42 = bxor v10, v31
    store notrap aligned v42, v32+72
    v43 = bxor v11, v31
    store notrap aligned v43, v32+80
    v44 = bxor v12, v31
    store notrap aligned v44, v32+88
    v45 = bxor v13, v31
    store notrap aligned v45, v32+96
    v46 = bxor v14, v31
    store notrap aligned v46, v32+104
    v47 = bxor v15, v31
    store notrap aligned v47, v32+112
    v48 = bxor v16, v31
    store notrap aligned v48, v32+120
    v49 = load.i64 notrap aligned v32+8
    return v49
}

