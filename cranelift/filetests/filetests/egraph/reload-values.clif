;; Once the slot's address reaches a call, the store may write it: nothing
;; reloads.

function %escaped_slot_past_unknown_store(i64, i64) -> i64 {
    ss0 = explicit_slot 128
    ss1 = explicit_slot 128
    fn0 = %observe(i64)
block0(v0: i64, v1: i64):
    v2 = stack_addr.i64 ss1
    call fn0(v2)
    v3 = load.i64 notrap aligned v2+0
    v4 = load.i64 notrap aligned v2+8
    v5 = load.i64 notrap aligned v2+16
    v6 = load.i64 notrap aligned v2+24
    v7 = load.i64 notrap aligned v2+32
    v8 = load.i64 notrap aligned v2+40
    v9 = load.i64 notrap aligned v2+48
    v10 = load.i64 notrap aligned v2+56
