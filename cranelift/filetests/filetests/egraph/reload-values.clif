;; Lanes in a stack slot whose address only loads and stores use: a store
;; through another pointer cannot write them, and they reload.

function %private_slot_past_unknown_store(i64, i64) -> i64 {
    ss0 = explicit_slot 128
    ss1 = explicit_slot 128
block0(v0: i64, v1: i64):
    v2 = stack_addr.i64 ss1
    v3 = load.i64 notrap aligned v2+0
    v4 = load.i64 notrap aligned v2+8
    v5 = load.i64 notrap aligned v2+16
    v6 = load.i64 notrap aligned v2+24
    v7 = load.i64 notrap aligned v2+32
    v8 = load.i64 notrap aligned v2+40
    v9 = load.i64 notrap aligned v2+48
    v10 = load.i64 notrap aligned v2+56
    v11 = load.i64 notrap aligned v2+64
    v12 = load.i64 notrap aligned v2+72
    v13 = load.i64 notrap aligned v2+80
    v14 = load.i64 notrap aligned v2+88
    v15 = load.i64 notrap aligned v2+96
    v16 = load.i64 notrap aligned v2+104
    v17 = load.i64 notrap aligned v2+112
    v18 = load.i64 notrap aligned v2+120
    v19 = iadd v3, v4
    v20 = iadd v19, v5
    v21 = iadd v20, v6
    v22 = iadd v21, v7
    v23 = iadd v22, v8
    v24 = iadd v23, v9
    v25 = iadd v24, v10
    v26 = iadd v25, v11
    v27 = iadd v26, v12
    v28 = iadd v27, v13
    v29 = iadd v28, v14
    v30 = iadd v29, v15
    v31 = iadd v30, v16
    v32 = iadd v31, v17
    v33 = iadd v32, v18
    store notrap aligned v33, v1
    v34 = stack_addr.i64 ss0
    v35 = bxor v3, v33
    store notrap aligned v35, v34+0
    v36 = bxor v4, v33
    store notrap aligned v36, v34+8
    v37 = bxor v5, v33
    store notrap aligned v37, v34+16
    v38 = bxor v6, v33
    store notrap aligned v38, v34+24
    v39 = bxor v7, v33
    store notrap aligned v39, v34+32
    v40 = bxor v8, v33
    store notrap aligned v40, v34+40
    v41 = bxor v9, v33
    store notrap aligned v41, v34+48
    v42 = bxor v10, v33
    store notrap aligned v42, v34+56
    v43 = bxor v11, v33
    store notrap aligned v43, v34+64
    v44 = bxor v12, v33
    store notrap aligned v44, v34+72
    v45 = bxor v13, v33
    store notrap aligned v45, v34+80
    v46 = bxor v14, v33
    store notrap aligned v46, v34+88
    v47 = bxor v15, v33
    store notrap aligned v47, v34+96
    v48 = bxor v16, v33
    store notrap aligned v48, v34+104
    v49 = bxor v17, v33
    store notrap aligned v49, v34+112
    v50 = bxor v18, v33
    store notrap aligned v50, v34+120
    v51 = load.i64 notrap aligned v34+8
    return v51
}

