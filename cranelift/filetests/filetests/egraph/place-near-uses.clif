;; Loads move in block order: `v1` moves down to its first use, the load
;; `v3`, before `v3` moves down to `v5`, so `v1` stays before its other use
;; `v4`.
function %load_feeding_a_load(i64) -> i64 {
block0(v0: i64):
    v1 = load.i64 notrap v0
    v2 = load.i64 notrap v0+8
    v3 = load.i64 notrap v1
    v4 = iadd v1, v2
    v5 = iadd v4, v3
    return v5
}

