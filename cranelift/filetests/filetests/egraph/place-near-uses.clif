;; Each load is used twice, so no `imul` moves up. The loads move down to
;; their first uses instead: `v2` cannot trap and passes the trapping `v3`,
;; while the trapping `v1` stays before `v3`.
function %loads_sink_in_trap_order(i64) -> i64 {
block0(v0: i64):
    v1 = load.i64 v0
    v2 = load.i64 notrap v0+8
    v3 = load.i64 v0+16
    v4 = imul v3, v3
    v5 = imul v2, v2
    v6 = imul v1, v1
    v7 = iadd v4, v5
    v8 = iadd v7, v6
    return v8
}

