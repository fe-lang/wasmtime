;; A load does not move past a store.
function %loads_stay_before_stores(i64, i64) -> i64 {
block0(v0: i64, v1: i64):
    v2 = load.i64 notrap v0
    v3 = load.i64 notrap v0+8
    store notrap v1, v0+16
    v4 = imul v2, v2
    v5 = imul v3, v3
    v6 = iadd v4, v5
    return v6
}

