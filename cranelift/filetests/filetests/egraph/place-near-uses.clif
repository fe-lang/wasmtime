test optimize precise-output
set opt_level=speed
target x86_64

;; Elaboration places each `bxor` just before its store, after all four loads.
;; The first `bxor`'s loads move down to it. The second `bxor`'s loads cannot
;; pass the first store, so that `bxor` moves up to them instead.
function %ops_follow_their_loads(i64, i64) {
block0(v0: i64, v1: i64):
    v2 = load.i64 notrap v0
    v3 = load.i64 notrap v0+8
    v4 = load.i64 notrap v0+16
    v5 = load.i64 notrap v0+24
    v6 = bxor v2, v3
    v7 = bxor v4, v5
    store notrap v6, v1
    store notrap v7, v1+8
    return
}

