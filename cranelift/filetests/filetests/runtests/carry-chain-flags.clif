test interpret
test run
set enable_llvm_abi_extensions=true
target x86_64

; Each carry in comes straight from the limb before, so the flags carry it.

function %add_three_limbs(i64, i64, i64, i64, i64, i64) -> i64, i8 {
block0(v0: i64, v1: i64, v2: i64, v3: i64, v4: i64, v5: i64):
    v6, v7 = uadd_overflow v0, v3
    v8, v9 = uadd_overflow_cin v1, v4, v7
    v10, v11 = uadd_overflow_cin v2, v5, v9
    v12 = bxor v6, v8
    v13 = bxor v12, v10
    return v13, v11
}
; run: %add_three_limbs(-1, -1, -1, 1, 0, 0) == [0, 1]
; run: %add_three_limbs(-1, 0, 5, 1, 0, 0) == [4, 0]
; run: %add_three_limbs(-1, -1, 5, 1, 0, 0) == [6, 0]
; run: %add_three_limbs(1, 2, 3, 4, 5, 6) == [11, 0]

function %sub_three_limbs(i64, i64, i64, i64, i64, i64) -> i64, i8 {
block0(v0: i64, v1: i64, v2: i64, v3: i64, v4: i64, v5: i64):
    v6, v7 = usub_overflow v0, v3
    v8, v9 = usub_overflow_bin v1, v4, v7
    v10, v11 = usub_overflow_bin v2, v5, v9
    v12 = bxor v6, v8
    v13 = bxor v12, v10
    return v13, v11
}
; run: %sub_three_limbs(0, 0, 0, 1, 0, 0) == [-1, 1]
; run: %sub_three_limbs(0, 0, 5, 1, 0, 0) == [4, 0]
; run: %sub_three_limbs(5, 6, 7, 1, 2, 3) == [4, 0]

function %add_two_i128_limbs(i128, i128, i128, i128) -> i128, i8 {
block0(v0: i128, v1: i128, v2: i128, v3: i128):
    v4, v5 = uadd_overflow v0, v2
    v6, v7 = uadd_overflow_cin v1, v3, v5
    v8 = bxor v4, v6
    return v8, v7
}
; run: %add_two_i128_limbs(-1, -1, 1, 0) == [0, 1]
; run: %add_two_i128_limbs(-1, 0, 1, 0) == [1, 0]

; Only the last borrow is used: the limbs before it still run.
function %borrow_out_of_unused_differences(i64, i64, i64, i64) -> i8 {
block0(v0: i64, v1: i64, v2: i64, v3: i64):
    v4, v5 = usub_overflow v0, v2
    v6, v7 = usub_overflow_bin v1, v3, v5
    return v7
}
; run: %borrow_out_of_unused_differences(0, 1, 1, 0) == 0
; run: %borrow_out_of_unused_differences(0, 1, 1, 1) == 1
; run: %borrow_out_of_unused_differences(5, 1, 4, 1) == 0

; A zero high half between the links leaves the borrow in the flags.
function %zero_between_links(i64, i64, i64, i64) -> i64, i64, i8 {
block0(v0: i64, v1: i64, v2: i64, v3: i64):
    v4, v5 = usub_overflow v0, v2
    v6 = iconst.i64 0
    v7 = iconcat v4, v6
    v8, v9 = usub_overflow_bin v1, v3, v5
    v10, v11 = isplit v7
    v12 = bxor v10, v11
    return v12, v8, v9
}
; run: %zero_between_links(0, 0, 1, 0) == [-1, -1, 1]
; run: %zero_between_links(1, 0, 1, 0) == [0, 0, 0]
; run: %zero_between_links(5, 7, 3, 7) == [2, 0, 0]
; run: %zero_between_links(0, 7, 1, 6) == [-1, 0, 0]
; run: %zero_between_links(-1, -1, 0, -1) == [-1, 0, 0]

; A stack slot address stored between the links.
function %borrow_past_stack_addr(i64, i64, i64, i64) -> i64, i64 {
    ss0 = explicit_slot 8
    ss1 = explicit_slot 8
block0(v0: i64, v1: i64, v2: i64, v3: i64):
    v4, v5 = usub_overflow v0, v2
    v6 = stack_addr.i64 ss0
    v7 = stack_addr.i64 ss1
    store notrap v6, v7
    v8, v9 = usub_overflow_bin v1, v3, v5
    store notrap v8, v6
    v10 = load.i64 notrap v7
    v11 = load.i64 notrap v10
    return v4, v11
}
; run: %borrow_past_stack_addr(0, 0, 1, 0) == [-1, -1]
; run: %borrow_past_stack_addr(1, 5, 1, 2) == [0, 3]
; run: %borrow_past_stack_addr(0, 5, 1, 5) == [-1, -1]
