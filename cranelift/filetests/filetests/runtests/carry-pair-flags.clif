test interpret
test run
set enable_multi_ret_implicit_sret
target x86_64
target x86_64 has_bmi2 has_adx

;; A link adding a constant before a second chain starts and the two
;; interleave: the second chain's first carry in is zero. `0x7fff...f + 1`
;; overflows, setting OF in an `adc`.
function %constant_link_before_pair(i64, i64, i64, i64, i64) -> i64, i64, i64 {
block0(v0: i64, v1: i64, v2: i64, v3: i64, v4: i64):
    v5, v6 = uadd_overflow v0, v1
    v7 = iconst.i64 1
    v8, v9 = uadd_overflow_cin v2, v7, v6
    v10 = iconst.i64 0
    v11, v12 = uadd_overflow v3, v4
    v13, v14 = uadd_overflow_cin v5, v10, v9
    v15, v16 = uadd_overflow_cin v8, v10, v12
    return v11, v13, v15
}

; run: %constant_link_before_pair(0, 0, 0x7fffffffffffffff, 0, 0) == [0, 0, -9223372036854775808]
; run: %constant_link_before_pair(-1, 1, 0x7fffffffffffffff, 0, 0) == [0, 0, -9223372036854775807]
; run: %constant_link_before_pair(0, 0, 0x7fffffffffffffff, -1, 1) == [0, 0, -9223372036854775807]
; run: %constant_link_before_pair(1, 2, 3, 4, 5) == [9, 3, 4]

function %constant_link_before_pair_register(i64, i64, i64, i64, i64, i64) -> i64, i64, i64 {
block0(v0: i64, v1: i64, v2: i64, v3: i64, v4: i64, v5: i64):
    v6, v7 = uadd_overflow v0, v1
    v8 = iconst.i64 1
    v9, v10 = uadd_overflow_cin v2, v8, v7
    v11, v12 = uadd_overflow v3, v4
    v13, v14 = uadd_overflow_cin v6, v5, v10
    v15, v16 = uadd_overflow_cin v9, v5, v12
    return v11, v13, v15
}

; run: %constant_link_before_pair_register(0, 0, 0x7fffffffffffffff, 0, 0, 0) == [0, 0, -9223372036854775808]
; run: %constant_link_before_pair_register(0, 0, 0x7fffffffffffffff, 0, 0, 5) == [0, 5, -9223372036854775803]
; run: %constant_link_before_pair_register(1, 2, 3, 4, 5, 6) == [9, 9, 10]

;; A link adding a negative 32-bit constant before the pair is an `adcx` of a
;; sign-extended `movq`.

function %negative_link_before_pair(i64, i64, i64, i64, i64) -> i64, i64, i64 {
block0(v0: i64, v1: i64, v2: i64, v3: i64, v4: i64):
    v5, v6 = uadd_overflow v0, v1
    v7 = iconst.i64 -1
    v8, v9 = uadd_overflow_cin v2, v7, v6
    v10 = iconst.i64 0
    v11, v12 = uadd_overflow v3, v4
    v13, v14 = uadd_overflow_cin v5, v10, v9
    v15, v16 = uadd_overflow_cin v8, v10, v12
    return v11, v13, v15
}

; run: %negative_link_before_pair(0, 0, -9223372036854775808, 0, 0) == [0, 1, 9223372036854775807]
; run: %negative_link_before_pair(-1, 1, -9223372036854775808, -1, 1) == [0, 1, -9223372036854775807]
; run: %negative_link_before_pair(1, 2, 3, 4, 5) == [9, 4, 2]
; run: %negative_link_before_pair(0, 0, 0, -1, 1) == [0, 0, 0]
