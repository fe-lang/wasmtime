test run
target x86_64 has_sha

;; The SHA-256 instructions of Intel's SHA extensions. Lanes are listed from
;; lane 0, the low word; `x86_sha256rnds2` takes C, D, G, H in `x` and A, B,
;; E, F in `y`, each from lane 3 down.

function %sha256msg1(i32x4, i32x4) -> i32x4 {
block0(v0: i32x4, v1: i32x4):
    v2 = x86_sha256msg1 v0, v1
    return v2
}
; run: %sha256msg1([0x01234567 0x89abcdef 0xfedcba98 0x76543210], [0x0f1e2d3c 0x4b5a6978 0x8796a5b4 0xc3d2e1f0]) == [0x3e8111b3 0x8a2bdf80 0x217eee4b 0x69072c4a]

function %sha256msg2(i32x4, i32x4) -> i32x4 {
block0(v0: i32x4, v1: i32x4):
    v2 = x86_sha256msg2 v0, v1
    return v2
}
; run: %sha256msg2([0x01234567 0x89abcdef 0xfedcba98 0x76543210], [0x0f1e2d3c 0x4b5a6978 0x8796a5b4 0xc3d2e1f0]) == [0x87707bf7 0xb6a25b1a 0x3181a9e0 0xdd17d723]

function %sha256rnds2(i32x4, i32x4, i32x4) -> i32x4 {
block0(v0: i32x4, v1: i32x4, v2: i32x4):
    v3 = x86_sha256rnds2 v0, v1, v2
    return v3
}
; run: %sha256rnds2([0x01234567 0x89abcdef 0xfedcba98 0x76543210], [0x0f1e2d3c 0x4b5a6978 0x8796a5b4 0xc3d2e1f0], [0x428a2f98 0x71374491 0xdeadbeef 0xcafebabe]) == [0x31569c23 0x247ecf07 0x6f45e91f 0xfa8ffc80]
