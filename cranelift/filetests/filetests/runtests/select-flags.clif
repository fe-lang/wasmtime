test interpret
test run
set enable_llvm_abi_extensions=true
target x86_64

;; Selects sharing one compare choose by it.

function %three_selects(i64, i64, i64, i64) -> i64 {
    ss0 = explicit_slot 24
block0(v0: i64, v1: i64, v2: i64, v3: i64):
    v4 = stack_addr.i64 ss0
    v5 = iconst.i64 1
    v6 = icmp eq v0, v5
    v7 = select v6, v1, v2
    store notrap v7, v4
    v8 = select v6, v2, v3
    store notrap v8, v4+8
    v9 = select v6, v3, v1
    store notrap v9, v4+16
    v10 = load.i64 notrap v4
    v11 = load.i64 notrap v4+8
    v12 = load.i64 notrap v4+16
    v17 = iconst.i64 100
    v18 = iconst.i64 10000
    v13 = imul v11, v17
    v14 = imul v12, v18
    v15 = iadd v10, v13
    v16 = iadd v15, v14
    return v16
}

; run: %three_selects(1, 1, 2, 3) == 30201
; run: %three_selects(0, 1, 2, 3) == 10302

;; A zero alternative between selects on one condition.

function %zero_between(i64, i64, i64, i64) -> i64 {
block0(v0: i64, v1: i64, v2: i64, v3: i64):
    v4 = iconst.i64 1
    v5 = band v0, v4
    v6 = select v5, v1, v2
    v7 = iconst.i64 0
    v8 = select v5, v3, v7
    v9 = iconst.i64 100
    v10 = imul v8, v9
    v11 = iadd v6, v10
    return v11
}

; run: %zero_between(1, 1, 2, 3) == 301
; run: %zero_between(0, 1, 2, 3) == 2
; run: %zero_between(3, 4, 5, 6) == 604
; run: %zero_between(2, 4, 5, 6) == 5

;; A stack slot address between selects on one condition.

function %stack_addr_between(i64, i64, i64, i64) -> i64 {
    ss0 = explicit_slot 16
block0(v0: i64, v1: i64, v2: i64, v3: i64):
    v4 = iconst.i64 1
    v5 = icmp eq v0, v4
    v6 = select v5, v1, v2
    v7 = stack_addr.i64 ss0
    store notrap v6, v7
    v8 = select v5, v2, v3
    store notrap v8, v7+8
    v9 = load.i64 notrap v7
    v10 = load.i64 notrap v7+8
    v11 = iconst.i64 100
    v12 = imul v10, v11
    v13 = iadd v9, v12
    return v13
}

; run: %stack_addr_between(1, 1, 2, 3) == 201
; run: %stack_addr_between(0, 1, 2, 3) == 302

;; The select between the zero and the select taking the flags of the first
;; one, used only by unused code, is skipped.

function %zero_before_skipped_select(i64, i64, i64, i64) -> i64 {
block0(v0: i64, v1: i64, v2: i64, v3: i64):
    v4 = iconst.i64 1
    v5 = band v0, v4
    v6 = iconst.i64 2
    v7 = band v0, v6
    v8 = select v5, v1, v2
    v9 = iconst.i64 0
    v10 = select v7, v1, v8
    v11 = select v5, v3, v9
    v12 = iadd v10, v10
    v13 = iconst.i64 100
    v14 = imul v11, v13
    v15 = iadd v8, v14
    return v15
}

; run: %zero_before_skipped_select(1, 1, 2, 3) == 301
; run: %zero_before_skipped_select(0, 1, 2, 3) == 2
; run: %zero_before_skipped_select(2, 1, 2, 3) == 2
; run: %zero_before_skipped_select(3, 1, 2, 3) == 301

;; A narrow `bt` condition reused across a zero.

function %bit_test_past_zero(i8, i8, i64, i64, i64) -> i64, i64 {
block0(v0: i8, v1: i8, v2: i64, v3: i64, v4: i64):
    v5 = iconst.i8 1
    v6 = ishl v5, v1
    v7 = band v0, v6
    v8 = select v7, v2, v3
    v9 = iconst.i64 0
    v10 = select v7, v4, v9
    return v8, v10
}

; run: %bit_test_past_zero(1, 0, 10, 20, 30) == [10, 30]
; run: %bit_test_past_zero(2, 0, 10, 20, 30) == [20, 0]
; run: %bit_test_past_zero(4, 10, 10, 20, 30) == [10, 30]

;; Selected stack slot addresses between selects on one condition.

function %stack_addrs_between(i64, i64, i64) -> i64, i64 {
    ss0 = explicit_slot 8
    ss1 = explicit_slot 8
block0(v0: i64, v1: i64, v2: i64):
    v3 = iconst.i64 1
    v4 = icmp eq v0, v3
    v5 = select v4, v1, v2
    v6 = stack_addr.i64 ss0
    v7 = stack_addr.i64 ss1
    v8 = select v4, v6, v7
    store notrap v1, v6
    store notrap v2, v7
    v9 = load.i64 notrap v8
    return v5, v9
}

; run: %stack_addrs_between(1, 10, 20) == [10, 10]
; run: %stack_addrs_between(0, 10, 20) == [20, 20]

;; Narrow zeros between a borrow and the selects on it.

function %narrow_zeros(i32, i32, i8, i16) -> i8, i16, i32 {
block0(v0: i32, v1: i32, v2: i8, v3: i16):
    v4, v5 = usub_overflow v0, v1
    v6 = iconst.i8 0
    v7 = select v5, v2, v6
    v8 = iconst.i16 0
    v9 = select v5, v3, v8
    v10 = iconst.i32 0
    v11 = select v5, v4, v10
    return v7, v9, v11
}

; run: %narrow_zeros(1, 2, 5, 7) == [5, 7, -1]
; run: %narrow_zeros(2, 1, 5, 7) == [0, 0, 0]
; run: %narrow_zeros(0, -1, -1, -1) == [-1, -1, 1]
; run: %narrow_zeros(-1, 0, -1, -1) == [0, 0, 0]

;; A 128-bit zero between selects on one condition.

function %wide_zero_between(i64, i64, i64, i64) -> i64, i64 {
    ss0 = explicit_slot 16
block0(v0: i64, v1: i64, v2: i64, v3: i64):
    v4 = iconst.i64 1
    v5 = band v0, v4
    v6 = select v5, v1, v2
    v7 = iconst.i64 0
    v8 = uextend.i128 v7
    v9 = select v5, v3, v1
    v10 = stack_addr.i64 ss0
    store notrap v8, v10
    v11 = load.i64 notrap v10+8
    v12 = iadd v9, v11
    return v6, v12
}

; run: %wide_zero_between(1, 10, 20, 30) == [10, 30]
; run: %wide_zero_between(0, 10, 20, 30) == [20, 10]

;; A float `eq` tests two flags, so the select after the zero compares again,
;; and the zero, which it takes in a register, stays an `xor`.

function %float_equal_past_zero(f64, f64, i64, i64) -> i64, i64 {
block0(v0: f64, v1: f64, v2: i64, v3: i64):
    v4 = fcmp eq v0, v1
    v5 = uextend.i64 v4
    v6 = select v5, v2, v3
    v7 = iconst.i64 0
    v8 = select v5, v7, v3
    return v6, v8
}

; run: %float_equal_past_zero(0x1.0, 0x1.0, 10, 20) == [10, 0]
; run: %float_equal_past_zero(0x1.0, 0x2.0, 10, 20) == [20, 20]
; run: %float_equal_past_zero(+NaN, +NaN, 10, 20) == [20, 20]

;; A float compare testing one flag, and a 128-bit compare, are shared.

function %float_less_past_zero(f64, f64, i64, i64) -> i64, i64 {
block0(v0: f64, v1: f64, v2: i64, v3: i64):
    v4 = fcmp lt v0, v1
    v5 = select v4, v2, v3
    v6 = iconst.i64 0
    v7 = select v4, v3, v6
    return v5, v7
}

; run: %float_less_past_zero(0x1.0, 0x2.0, 10, 20) == [10, 20]
; run: %float_less_past_zero(0x2.0, 0x1.0, 10, 20) == [20, 0]
; run: %float_less_past_zero(+NaN, 0x1.0, 10, 20) == [20, 0]
; run: %float_less_past_zero(0x1.0, +NaN, 10, 20) == [20, 0]

function %wide_less_past_zero(i128, i128, i64, i64) -> i64, i64 {
block0(v0: i128, v1: i128, v2: i64, v3: i64):
    v4 = icmp ult v0, v1
    v5 = select v4, v2, v3
    v6 = iconst.i64 0
    v7 = select v4, v3, v6
    return v5, v7
}

; run: %wide_less_past_zero(1, 2, 10, 20) == [10, 20]
; run: %wide_less_past_zero(2, 1, 10, 20) == [20, 0]
; run: %wide_less_past_zero(0x10000000000000000, 0x1ffffffffffffffff, 10, 20) == [10, 20]
; run: %wide_less_past_zero(-1, 1, 10, 20) == [20, 0]

;; A zero that a store also takes.

function %zero_stored_between(i64, i64, i64) -> i64, i64, i64 {
    ss0 = explicit_slot 8
block0(v0: i64, v1: i64, v2: i64):
    v3 = stack_addr.i64 ss0
    store notrap v0, v3
    v4 = iconst.i64 1
    v5 = band v0, v4
    v6 = select v5, v1, v2
    v7 = iconst.i64 0
    store notrap v7, v3
    v8 = select v5, v2, v7
    v9 = load.i64 notrap v3
    return v6, v8, v9
}

; run: %zero_stored_between(1, 10, 20) == [10, 20, 0]
; run: %zero_stored_between(2, 10, 20) == [20, 0, 0]

;; A stack slot address at an offset in a large frame.

function %stack_addr_offset_between(i64, i64, i64) -> i64, i64 {
    ss0 = explicit_slot 8192
block0(v0: i64, v1: i64, v2: i64):
    v3 = iconst.i64 1
    v4 = icmp eq v0, v3
    v5 = select v4, v1, v2
    v6 = stack_addr.i64 ss0+4096
    v7 = stack_addr.i64 ss0+8
    v8 = select v4, v6, v7
    store notrap v1, v6
    store notrap v2, v7
    v9 = load.i64 notrap v8
    return v5, v9
}

; run: %stack_addr_offset_between(1, 10, 20) == [10, 10]
; run: %stack_addr_offset_between(0, 10, 20) == [20, 20]

