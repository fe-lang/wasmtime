test interpret
test run
set enable_llvm_abi_extensions=true
target x86_64

;; Selects sharing one compare choose by it.

function %three_selects(i64, i64, i64, i64) -> i64 {
    ss0 = explicit_slot 24
block0(v0: i64, v1: i64, v2: i64, v3: i64):
    v4 = stack_addr.i64 ss0
    v5 = iconst.i64 1
    v6 = icmp eq v0, v5
    v7 = select v6, v1, v2
    store notrap v7, v4
    v8 = select v6, v2, v3
    store notrap v8, v4+8
    v9 = select v6, v3, v1
    store notrap v9, v4+16
    v10 = load.i64 notrap v4
    v11 = load.i64 notrap v4+8
    v12 = load.i64 notrap v4+16
    v17 = iconst.i64 100
    v18 = iconst.i64 10000
    v13 = imul v11, v17
    v14 = imul v12, v18
    v15 = iadd v10, v13
    v16 = iadd v15, v14
    return v16
}

; run: %three_selects(1, 1, 2, 3) == 30201
; run: %three_selects(0, 1, 2, 3) == 10302

;; A zero alternative between selects on one condition.

function %zero_between(i64, i64, i64, i64) -> i64 {
block0(v0: i64, v1: i64, v2: i64, v3: i64):
    v4 = iconst.i64 1
    v5 = band v0, v4
    v6 = select v5, v1, v2
    v7 = iconst.i64 0
    v8 = select v5, v3, v7
    v9 = iconst.i64 100
    v10 = imul v8, v9
    v11 = iadd v6, v10
    return v11
}

; run: %zero_between(1, 1, 2, 3) == 301
; run: %zero_between(0, 1, 2, 3) == 2
; run: %zero_between(3, 4, 5, 6) == 604
; run: %zero_between(2, 4, 5, 6) == 5

;; A stack slot address between selects on one condition.

function %stack_addr_between(i64, i64, i64, i64) -> i64 {
    ss0 = explicit_slot 16
block0(v0: i64, v1: i64, v2: i64, v3: i64):
    v4 = iconst.i64 1
    v5 = icmp eq v0, v4
    v6 = select v5, v1, v2
    v7 = stack_addr.i64 ss0
    store notrap v6, v7
    v8 = select v5, v2, v3
    store notrap v8, v7+8
    v9 = load.i64 notrap v7
    v10 = load.i64 notrap v7+8
    v11 = iconst.i64 100
    v12 = imul v10, v11
    v13 = iadd v9, v12
    return v13
}

; run: %stack_addr_between(1, 1, 2, 3) == 201
; run: %stack_addr_between(0, 1, 2, 3) == 302

;; The select between the zero and the select taking the flags of the first
;; one, used only by unused code, is skipped.

function %zero_before_skipped_select(i64, i64, i64, i64) -> i64 {
block0(v0: i64, v1: i64, v2: i64, v3: i64):
    v4 = iconst.i64 1
    v5 = band v0, v4
    v6 = iconst.i64 2
    v7 = band v0, v6
    v8 = select v5, v1, v2
    v9 = iconst.i64 0
    v10 = select v7, v1, v8
    v11 = select v5, v3, v9
    v12 = iadd v10, v10
    v13 = iconst.i64 100
    v14 = imul v11, v13
    v15 = iadd v8, v14
    return v15
}

; run: %zero_before_skipped_select(1, 1, 2, 3) == 301
; run: %zero_before_skipped_select(0, 1, 2, 3) == 2
; run: %zero_before_skipped_select(2, 1, 2, 3) == 2
; run: %zero_before_skipped_select(3, 1, 2, 3) == 301
